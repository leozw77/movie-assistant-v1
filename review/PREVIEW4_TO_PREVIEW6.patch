+#!/usr/bin/env python3
+from __future__ import annotations
+
+from pathlib import Path
+import re
+import sys
+import xml.etree.ElementTree as ET
+
+ROOT = Path(__file__).resolve().parents[1]
+PASSES: list[str] = []
+FAILURES: list[str] = []
+
+
+def check(name: str, condition: bool, detail: str = "") -> None:
+    line = f"{'PASS' if condition else 'FAIL'}: {name}" + (f" | {detail}" if detail else "")
+    (PASSES if condition else FAILURES).append(line)
+    print(line)
+
+
+def text(relative: str) -> str:
+    return (ROOT / relative).read_text(encoding="utf-8-sig")
+
+
+# Project/version integrity.
+try:
+    ET.parse(ROOT / "观影助手.csproj")
+    check("csproj XML 可解析", True)
+except Exception as exc:
+    check("csproj XML 可解析", False, str(exc))
+
+version = text("VERSION").strip()
+project = text("观影助手.csproj")
+crash = text("CrashLogger.cs")
+check("VERSION 为 preview.6", version == "0.9.0-preview.6", version)
+check("VERSION 与 csproj 一致", f"<Version>{version}</Version>" in project)
+check("VERSION 与运行日志版本一致", f'public const string Version = "{version}";' in crash)
+
+# Active bridge/API boundary.
+html_form = text("HtmlMediaLibraryForm.cs")
+connector_api = text("DoubanConnector.cs")
+connector_v2 = text("DoubanWebView2Connector.ReviewWriteV2.cs")
+connector_core = text("DoubanWebView2Connector.cs")
+app = text("WebAssets/MediaLibrary/app.js")
+index = text("WebAssets/MediaLibrary/index.html")
+models = text("ReviewWriteModels.cs")
+resolver = text("ReviewTargetResolver.cs")
+coordinator = text("ReviewWriteCoordinator.cs")
+submit_script = text("DoubanOfficialFormScripts.cs")
+settlement = text("ReviewSettlementPolicy.cs")
+verifier = text("ReviewWriteVerifier.cs")
+
+check("活动接口只暴露评价读取与 v2 保存", "ReadOfficialReviewAsync" in connector_api and "DoubanEntryWriteRequestV2" in connector_api and "DeleteAsync" not in connector_api)
+check("桥接白名单禁止旧删除", '"saveDoubanEntry"' in html_form and '"deleteEntry"' not in html_form.split("private readonly", 1)[0] and '"delete"' not in html_form.split("private readonly", 1)[0])
+check("前端删除按钮明确禁用", 'id="deleteEntry" type="button" class="danger" disabled' in index and '$(' + '"deleteEntry").disabled = true' in app)
+check("旧写入入口降级为私有 legacy", "private Task<DoubanWriteResult> SaveDoubanEntryLegacyAsync" in connector_core and "private Task<DoubanWriteResult> DeleteLegacyAsync" in connector_core)
+
+# Explicit mutation protocol.
+check("模型定义 Keep/Set/Clear", all(token in models for token in ("Keep", "Set", "Clear")))
+check("空值与未知值分离", all(token in models for token in ("ExistsKnown", "RatingKnown", "CommentKnown")))
+check("前端发送 ratingAction/commentAction", all(token in app for token in ("ratingAction", "commentAction")))
+check("前端不再构造 setComment 旧协议", "const setComment" not in app)
+check("想看最终状态强制无评分", "rating = null" in resolver and "RatingWasImplicitlyClearedByWish" in models)
+check("Keep 从最新官方值合并", "official.Rating" in resolver and "official.Comment" in resolver)
+
+# Web-authoritative read and safe absence rule.
+check("详情页先读取官方评价", "ReadOfficialReviewAsync(subjectUrl)" in html_form)
+check("完整官方快照覆盖本地", "ApplyAuthoritativeReview" in html_form and "SelectAuthoritativeSnapshot" in html_form)
+check("官方明确无评价才清空本地", "if (!official.Exists)" in html_form and "record.Rating = null" in html_form and 'record.Comment = ""' in html_form)
+check("表单可见不被当成无评价证据", 'var existsKnown = detailExistsKnown || formIndicatesExisting;' in connector_v2 and 'Boolean(form, "ready")' not in connector_v2.split("var existsKnown",1)[1].split(";",1)[0])
+check("不完整官方读取阻止提交", 'before.Error is not null || !before.ExistsKnown || !before.StatusKnown' in coordinator)
+
+# Submit/settlement/readback pipeline.
+first_read = coordinator.find("ReadOfficialAsync")
+submit = coordinator.find("SubmitTargetAsync")
+settle = coordinator.find("WaitForSettlementAsync")
+second_read = coordinator.find("ReadOfficialAsync", first_read + 1)
+verify = coordinator.find("ReviewWriteVerifier.Verify")
+cache_write = coordinator.rfind("OverwriteFromOfficialAsync")
+check("管线顺序为读取→提交→结算→回读→验证→本地", -1 not in (first_read, submit, settle, second_read, verify, cache_write) and first_read < submit < settle < second_read < verify < cache_write)
+check("提交使用官方 form.requestSubmit", "form.requestSubmit(submitButton)" in submit_script)
+check("提交不使用 fetch/private HTTP", not re.search(r"\bfetch\s*\(", submit_script, re.I))
+check("提交不读取 cookie", "document.cookie" not in submit_script)
+check("隐藏评分只读取不直接赋值", "ratingHidden?.value" in submit_script and not re.search(r"ratingHidden\s*\.\s*value\s*=", submit_script))
+check("提交前复核状态评分短评", "提交前官方表单复核失败" in submit_script)
+check("结算要求连续两次稳定", "_stableSamples >= 2" in settlement)
+check("超时返回不确定而非成功", "timeout-uncertain" in settlement and "结果标记为不确定" in settlement)
+check("最终成功必须官方逐字段匹配", all(token in verifier for token in ("Status", "Rating", "Comment")) and "verification.Matches" in coordinator)
+check("失败/不确定不写目标值", coordinator.find("if (!verification.Matches)") < cache_write and "LocalUpdated: false" in coordinator)
+
+# UI semantics.
+check("UI 明示网页为准", "网页为准" in index)
+check("清除评分文案真实", ">清除评分</button>" in index)
+check("结果阶段包含 official-read/settlement", '"official-read"' in app and 'settlement: "等待豆瓣结算"' in app)
+check("删除点击不会发送 WebMessage", 'writeOperation("deleteEntry"' not in app)
+
+# Basic delimiter balance (string/comment-aware enough for these files).
+def delimiters_ok(source: str) -> tuple[bool, str]:
+    stack: list[tuple[str, int]] = []
+    pairs = {")": "(", "]": "[", "}": "{"}
+    i = 0
+    state = "code"
+    while i < len(source):
+        c = source[i]
+        n = source[i + 1] if i + 1 < len(source) else ""
+        if state == "code":
+            if c == "/" and n == "/": state, i = "line", i + 2; continue
+            if c == "/" and n == "*": state, i = "block", i + 2; continue
+            if source[i:i+4] == '$"""': state, i = "raw", i + 4; continue
+            if source[i:i+3] == '"""': state, i = "raw", i + 3; continue
+            if c == "@" and n == '"': state, i = "verbatim", i + 2; continue
+            if c == "$" and n == '"': state, i = "string", i + 2; continue
+            if c == '"': state, i = "string", i + 1; continue
+            if c == "'": state, i = "char", i + 1; continue
+            if c in "([{": stack.append((c, i))
+            elif c in ")]}":
+                if not stack or stack[-1][0] != pairs[c]: return False, f"mismatch {c} at {i}"
+                stack.pop()
+            i += 1; continue
+        if state == "line":
+            if c == "\n": state = "code"
+            i += 1; continue
+        if state == "block":
+            if c == "*" and n == "/": state, i = "code", i + 2
+            else: i += 1
+            continue
+        if state in ("string", "char"):
+            closing = '"' if state == "string" else "'"
+            if c == "\\": i += 2
+            elif c == closing: state, i = "code", i + 1
+            else: i += 1
+            continue
+        if state == "verbatim":
+            if c == '"' and n == '"': i += 2
+            elif c == '"': state, i = "code", i + 1
+            else: i += 1
+            continue
+        if state == "raw":
+            if source[i:i+3] == '"""': state, i = "code", i + 3
+            else: i += 1
+            continue
+    return (not stack and state in ("code", "line")), f"state={state}, stack={stack[-3:]}"
+
+for relative in (
+    "DoubanConnector.cs", "DoubanWebView2Connector.cs", "DoubanWebView2Connector.ReviewWriteV2.cs",
+    "HtmlMediaLibraryForm.cs", "ReviewWriteModels.cs", "ReviewTargetResolver.cs",
+    "ReviewWriteCoordinator.cs", "ReviewSettlementPolicy.cs", "DoubanOfficialFormScripts.cs",
+    "OfficialReviewCachePolicy.cs", "ReviewWriteVerifier.cs", "SelfTest.cs"):
+    ok, detail = delimiters_ok(text(relative))
+    check(f"{relative} 分隔符平衡", ok, detail if not ok else "")
+
+print(f"SUMMARY: {len(PASSES)} passed, {len(FAILURES)} failed")
+sys.exit(1 if FAILURES else 0)
