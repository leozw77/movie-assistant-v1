@@ -0,0 +1,69 @@
+using System;
+using System.Threading;
+using System.Threading.Tasks;
+namespace QbPotDoubanAi;
+
+/// <summary>
+/// Local data is a cache only. A successful official read overwrites every known field,
+/// including null rating and empty comment. Unknown fields never masquerade as empty fields.
+/// </summary>
+internal static class OfficialReviewCachePolicy
+{
+    public static CachedReviewState Merge(
+        CachedReviewState? existing,
+        string subjectId,
+        string subjectUrl,
+        OfficialReviewSnapshot official,
+        DateTimeOffset verifiedAt)
+    {
+        ArgumentNullException.ThrowIfNull(official);
+
+        if (!official.ExistsKnown)
+            throw new InvalidOperationException("官方是否存在字段未知，不能覆盖本地缓存。");
+
+        if (!official.Exists)
+        {
+            return new CachedReviewState(
+                subjectId,
+                subjectUrl,
+                Exists: false,
+                Status: null,
+                Rating: null,
+                Comment: string.Empty,
+                VerifiedAt: verifiedAt,
+                Source: official.Source);
+        }
+
+        if (!official.StatusKnown || !official.RatingKnown || !official.CommentKnown)
+            throw new InvalidOperationException("官方评价字段不完整，不能进行权威覆盖。");
+
+        return new CachedReviewState(
+            subjectId,
+            subjectUrl,
+            Exists: true,
+            Status: ReviewTargetResolver.NormalizeStatus(official.Status),
+            Rating: official.Rating,
+            Comment: ReviewTargetResolver.NormalizeComment(official.Comment),
+            VerifiedAt: verifiedAt,
+            Source: official.Source);
+    }
+}
+
+internal sealed record CachedReviewState(
+    string SubjectId,
+    string SubjectUrl,
+    bool Exists,
+    string? Status,
+    int? Rating,
+    string Comment,
+    DateTimeOffset VerifiedAt,
+    string Source);
+
+internal interface IOfficialReviewCacheWriter
+{
+    Task<bool> OverwriteFromOfficialAsync(
+        string subjectId,
+        string subjectUrl,
+        OfficialReviewSnapshot official,
+        CancellationToken cancellationToken);
+}
