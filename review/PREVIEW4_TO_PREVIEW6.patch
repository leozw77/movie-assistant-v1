+"use strict";
+const fs = require("fs");
+const vm = require("vm");
+const path = require("path");
+
+const root = path.resolve(__dirname, "..");
+const source = fs.readFileSync(path.join(root, "WebAssets", "MediaLibrary", "app.js"), "utf8");
+const match = source.match(/function resolvePendingMutations\(\) \{[\s\S]*?\n\}/);
+if (!match) throw new Error("resolvePendingMutations not found");
+
+function run({ baseline, status, rating, comment }) {
+  const elements = {
+    writeRating: { dataset: { value: rating == null ? "" : String(rating) } },
+    writeReview: { value: comment }
+  };
+  const context = {
+    state: { writeBaseline: baseline },
+    selectedWriteStatus: () => status,
+    $: id => elements[id]
+  };
+  vm.createContext(context);
+  vm.runInContext(`${match[0]}; result = resolvePendingMutations();`, context);
+  return JSON.parse(JSON.stringify(context.result));
+}
+
+function assertDeep(actual, expected, name) {
+  const a = JSON.stringify(actual);
+  const e = JSON.stringify(expected);
+  if (a !== e) throw new Error(`${name}\nexpected ${e}\nactual   ${a}`);
+  console.log(`PASS: ${name}`);
+}
+
+assertDeep(
+  run({ baseline:{status:"collect",rating:4,comment:"A"}, status:"collect", rating:4, comment:"A" }),
+  {status:"collect",ratingAction:"keep",rating:null,commentAction:"keep",comment:null},
+  "unchanged fields use keep"
+);
+assertDeep(
+  run({ baseline:{status:"collect",rating:4,comment:"A"}, status:"collect", rating:null, comment:"A" }),
+  {status:"collect",ratingAction:"clear",rating:null,commentAction:"keep",comment:null},
+  "rating clear is explicit"
+);
+assertDeep(
+  run({ baseline:{status:"collect",rating:4,comment:"A"}, status:"collect", rating:5, comment:"A" }),
+  {status:"collect",ratingAction:"set",rating:5,commentAction:"keep",comment:null},
+  "rating set carries value"
+);
+assertDeep(
+  run({ baseline:{status:"collect",rating:4,comment:"A"}, status:"collect", rating:4, comment:"" }),
+  {status:"collect",ratingAction:"keep",rating:null,commentAction:"clear",comment:null},
+  "comment clear is explicit"
+);
+assertDeep(
+  run({ baseline:{status:"collect",rating:4,comment:"A"}, status:"collect", rating:4, comment:"B" }),
+  {status:"collect",ratingAction:"keep",rating:null,commentAction:"set",comment:"B"},
+  "comment set carries value"
+);
+assertDeep(
+  run({ baseline:{status:"collect",rating:4,comment:"A"}, status:"wish", rating:null, comment:"A" }),
+  {status:"wish",ratingAction:"clear",rating:null,commentAction:"keep",comment:null},
+  "wish resolves existing rating to clear"
+);
+console.log("ALL_PROTOCOL_TESTS_OK");
